# Pocket ID environment configuration
# Copy to app.env and adjust values as needed

# Timezone
TZ=America/New_York

# Hostname / domain
BASE_HOST_NAME=pocketid
BASE_DOMAIN_NAME=example.com

# MaxMind GeoIP license key (optional, for IP geolocation)
# Obtain from https://www.maxmind.com/en/geolite2/signup
MAXMIND_LICENSE_KEY=
