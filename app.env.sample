# Pocket ID — environment variable reference
# Copy relevant lines to a .env file alongside docker-compose.yaml

# Timezone
TZ=America/New_York

# Hostname / domain
BASE_HOST_NAME=${HOSTNAME}
BASE_DOMAIN_NAME=example.com

# MaxMind GeoIP license key (optional — for IP geolocation)
# Obtain from https://www.maxmind.com/en/geolite2/signup
MAXMIND_LICENSE_KEY=
